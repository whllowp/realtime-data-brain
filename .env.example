# Copy to `.env` and edit. Real environment variables always win over this file.
#
# `python -m brian config --laya` prints the effective values (with secrets masked), so you can check
# what was actually loaded rather than what you meant to load.

# ---------------------------------------------------------------------------------------
# The decision engine (System 1)
# ---------------------------------------------------------------------------------------
# Laya is reached over HTTP and never imported, so this process holds no torch and no VRAM. Start the
# service first:  D:\project\laya\service\start.cmd
LAYA_URL=http://127.0.0.1:8077

# Which checkpoint answers. `typed-decisions` is the fine-tuned specialist and the shipped default;
# `english` and `multilingual` are the base checkpoints (the latter for non-English log text).
BRIAN_LAYA_MODEL=typed-decisions

# Only needed if the service was started with --api-key.
# LAYA_API_KEY=

# Deterministic answers mean an identical digest can be served from cache, so this is a latency knob,
# not a correctness one.
BRIAN_LAYA_CACHE_SIZE=4096

# ---------------------------------------------------------------------------------------
# The reasoner (System 2)
# ---------------------------------------------------------------------------------------
# Without a key the pipeline runs its deterministic rule-based reasoner instead: a report is still
# produced, it is marked `degraded: true`, and every proposed action is forced to require a human.
DEEPSEEK_API_KEY=
BRIAN_LLM_MODEL=deepseek-chat
# Set to 1 to force the offline reasoner even when a key is present (useful for tests and for
# reproducing a report without spending tokens).
BRIAN_LLM_OFFLINE=0
BRIAN_LLM_MAX_TOKENS=2048
# How many raw events to include in the RCA prompt. Higher is more context and more cost.
BRIAN_LLM_MAX_CONTEXT_EVENTS=20

# ---------------------------------------------------------------------------------------
# The memory (Kafka)
# ---------------------------------------------------------------------------------------
# auto   -> use a real cluster when reachable, otherwise the append-only JSONL journal (default)
# kafka  -> require a cluster; fail loudly rather than judging without it
# journal / memory -> force the local backends
BRIAN_BUS_BACKEND=auto
BRIAN_KAFKA_BOOTSTRAP=127.0.0.1:9092
BRIAN_TOPIC_PREFIX=brian
# Kafka is the memory, so the default is `all` (every in-sync replica). Fire-and-forget would defeat
# the purpose of an audit trail.
BRIAN_KAFKA_ACKS=all
BRIAN_JOURNAL_DIR=var/journal

# ---------------------------------------------------------------------------------------
# The gate: the policy, and the only place automation is licensed
# ---------------------------------------------------------------------------------------
# THESE ARE ON THE CALIBRATED SCALE. The gate applies the fitted Platt correction before any threshold,
# so a threshold picked on the raw scale will not fire and recall will read 0.000. `brian eval` warns
# when it detects that mismatch.
#
# The shipped values are the quietest operating point that still reaches 0.85 recall on labelled
# windows (recall 0.854, FPR 0.000, precision 1.000). Re-derive them for your own traffic with
# `scripts/threshold_sweep.py`, and again after fine-tuning the checkpoint — the whole table moves.
BRIAN_GATE_ANOMALY_P=0.5583
BRIAN_GATE_NOTIFY_P=0.5583
# Confidence needed to act on the category and severity without System 2.
BRIAN_GATE_CONF_AUTO=0.75
# Below this the judgement is too weak to route at all, so System 2 reasons instead.
BRIAN_GATE_CONF_FLOOR=0.45
# Severity rank at or above which a human is paged (0 info, 1 minor, 2 major, 3 critical).
BRIAN_GATE_PAGE_RANK=2
# Suppression needs more confidence than alerting: a false silence is worse than a false alert.
BRIAN_GATE_SUPPRESS_CONF=0.70
BRIAN_GATE_NORMAL_P=0.35

# ---------------------------------------------------------------------------------------
# Windowing (mirrors what the Flink job does)
# ---------------------------------------------------------------------------------------
BRIAN_WINDOW_SIZE_S=60
BRIAN_WINDOW_SLIDE_S=60
# How long to wait for late events before closing a window.
BRIAN_ALLOWED_LATENESS_S=30
# Watermark idle timeout: without it one silent service stalls every other service's windows.
BRIAN_IDLE_TIMEOUT_S=120
# Rolling baseline length. Long enough to be stable, short enough to track a shift.
BRIAN_BASELINE_WINDOWS=30
# Below this a window is recorded but not judged: too little data to accuse anyone of anything.
BRIAN_MIN_WINDOW_EVENTS=10

# ---------------------------------------------------------------------------------------
# Confidence calibration
# ---------------------------------------------------------------------------------------
# The fit is a deployment artefact: loaded once, recorded on every decision.
BRIAN_CALIBRATION_PATH=models/calibration/anomaly_temperature.json
# Set to 0 to measure the checkpoint's raw behaviour (this is what `brian calibrate` does internally,
# and what a benchmark that is evaluating the model rather than operating it should do).
BRIAN_CALIBRATION_ENABLED=1

# ---------------------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------------------
BRIAN_LOG_LEVEL=info
# Echo every record to stdout as JSON, on top of writing it to the memory.
BRIAN_ECHO=0
